Options -MultiViews
RewriteEngine On

# O HTML nunca fica preso no cache; os arquivos versionados continuam rápidos.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Mantem arquivos, imagens e endpoints PHP existentes acessiveis normalmente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Entrega o aplicativo React ao atualizar ou abrir uma rota interna diretamente.
RewriteRule ^ index.html [L]
